[Unit]
Description=StrayNet API (Fastify)
# The database is managed (Supabase), so there is no local postgresql.service
# to order against — see AGENTS.md. Only the network needs to be up.
After=network.target

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
Environment=NODE_ENV=production
Environment=PORT=8080
EnvironmentFile=__REPO_ROOT__/apps/api/.env.production
ExecStart=__NODE_BIN__ apps/api/dist/server.js
Restart=always
RestartSec=3
# OOM containment. MemoryHigh/MemoryMax below are tuned for a 3GB box running
# multiple agents alongside this service -- raise them if this ever moves to
# a larger box.
MemoryHigh=350M
MemoryMax=500M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
