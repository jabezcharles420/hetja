{
  "name": "@hetja/api",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "admin:grant": "tsx src/cli/grant-admin.ts grant",
    "admin:revoke": "tsx src/cli/grant-admin.ts revoke",
    "admin:list": "tsx src/cli/grant-admin.ts list",
    "verified:grant": "tsx src/cli/grant-verified.ts grant",
    "verified:revoke": "tsx src/cli/grant-verified.ts revoke",
    "verified:list": "tsx src/cli/grant-verified.ts list"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/etag": "^6.2.0",
    "@fastify/helmet": "^13.1.1",
    "@hetja/contracts": "workspace:*",
    "@hetja/db": "workspace:*",
    "@hetja/ledger": "workspace:^",
    "altcha-lib": "2.4.0",
    "fastify": "^5.12.1",
    "lru-cache": "^11.5.2",
    "libphonenumber-js": "^1.13.12",
    "nodemailer": "^9.1.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1"
  }
}
