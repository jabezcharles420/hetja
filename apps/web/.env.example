# StrayNet Web (Next.js) — environment template. Copy to .env.production.
#
# NEXT_PUBLIC_* values are INLINED INTO THE BUNDLE AT BUILD TIME. Changing them
# requires a rebuild (`pnpm --filter @straynet/web build`) — restarting the
# service alone has no effect.

# Origin of the StrayNet API, with NO path component. The client appends the
# /api/v1 prefix itself (see lib/api.ts). Must be an origin the browser can
# reach — never "localhost" in production, which resolves to the visitor's own
# device.
NEXT_PUBLIC_API_URL=https://api.hetja.in

# Supabase — publishable (anon) key only. This key ships to the browser, so
# every table it can reach must be protected by RLS.
# Project-specific. Take both from the Supabase dashboard (Project Settings ->
# API). A project ref is deliberately NOT hardcoded here: this template used to
# name a specific project, which then outlived it when the database moved region
# and left a dead hostname baked into the repo.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
