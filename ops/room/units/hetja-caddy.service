[Unit]
Description=Hetja Caddy (loopback :80, path routing for the tunnel)
After=network-online.target
Wants=network-online.target
PartOf=hetja.target

[Service]
Slice=hetja.slice
User=hetja
Group=hetja
Nice=10
OOMScoreAdjust=1000
Restart=on-failure
RestartSec=5
# Binds 127.0.0.1:80 only (default_bind in the Caddyfile). The capability is
# the ONLY privilege any Hetja unit holds; nothing here runs as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ReadWritePaths=/srv/hetja/shared
Environment=XDG_DATA_HOME=/srv/hetja/shared/caddy XDG_CONFIG_HOME=/srv/hetja/shared/caddy
ExecStart=/srv/hetja/bin/caddy run --config /srv/hetja/current/Caddyfile --adapter caddyfile
ExecReload=/srv/hetja/bin/caddy reload --config /srv/hetja/current/Caddyfile --adapter caddyfile --force

[Install]
WantedBy=hetja.target
