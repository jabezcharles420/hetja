[Unit]
Description=StrayNet scan landing (static)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/straynet
ExecStart=/usr/local/bin/node apps/scan/scripts/serve.mjs
Environment=PORT=8081
# Loopback only — Caddy terminates TLS and proxies /d/* here.
Environment=HOST=127.0.0.1
Restart=always
RestartSec=3
MemoryHigh=64M
MemoryMax=128M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
