[Unit]
Description=Hetja worker (job queue)
After=network-online.target
Wants=network-online.target
PartOf=hetja.target

[Service]
Slice=hetja.slice
User=hetja
Group=hetja
Nice=10
OOMScoreAdjust=1000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/hetja/shared /srv/hetja/photos
WorkingDirectory=/srv/hetja/current/worker
Environment=NODE_ENV=production NODE_OPTIONS=--max-old-space-size=56
EnvironmentFile=/srv/hetja/shared/api.env
ExecStart=/srv/hetja/bin/node dist/index.js

[Install]
WantedBy=hetja.target
