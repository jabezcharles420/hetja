[Unit]
Description=Hetja API (Fastify)
# The authoritative database is a LOCAL PostgreSQL on this box (AGENTS.md §b).
# An earlier version of this comment said it was managed Supabase and that
# "there is no local postgresql.service to order against" — the same stale
# claim that AGENTS.md was corrected for in 15a89e9, left behind here. Ordering
# after postgresql.service matters on a cold boot: without it the API starts
# while PostgreSQL is still coming up and fails its first health checks.
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
Environment=NODE_ENV=production
Environment=PORT=8080
EnvironmentFile=__REPO_ROOT__/apps/api/.env.production
ExecStart=__NODE_BIN__ apps/api/dist/server.js
Restart=always
RestartSec=3
# OOM containment. MemoryHigh/MemoryMax below are tuned for a 3GB box running
# multiple agents alongside this service -- raise them if this ever moves to
# a larger box.
MemoryHigh=350M
MemoryMax=500M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
