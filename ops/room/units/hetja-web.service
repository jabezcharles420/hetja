[Unit]
Description=Hetja web (Next.js standalone)
After=network-online.target
Wants=network-online.target
PartOf=hetja.target

[Service]
Slice=hetja.slice
User=hetja
Group=hetja
Nice=10
OOMScoreAdjust=1000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/srv/hetja/shared /srv/hetja/photos
WorkingDirectory=/srv/hetja/releases/current/web/apps/web
Environment=NODE_ENV=production PORT=3100 HOSTNAME=127.0.0.1 NODE_OPTIONS=--max-old-space-size=112
EnvironmentFile=-/srv/hetja/shared/web.env
ExecStart=/srv/hetja/bin/node server.js

[Install]
WantedBy=hetja.target
