[Unit]
Description=Hetja Worker (job queue)
# The database is managed (Supabase), so there is no local postgresql.service
# to order against — see AGENTS.md. Only the network needs to be up.
After=network.target

[Service]
Type=simple
WorkingDirectory=__REPO_ROOT__
Environment=NODE_ENV=production
EnvironmentFile=__REPO_ROOT__/apps/api/.env.production
ExecStart=__NODE_BIN__ apps/worker/dist/index.js
Restart=always
RestartSec=5
# OOM containment. MemoryHigh/MemoryMax below are tuned for a 3GB box --
# raise them if this ever moves to a larger box.
MemoryHigh=250M
MemoryMax=400M
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
