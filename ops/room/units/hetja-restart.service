[Unit]
Description=Restart Hetja services for a new release

[Service]
Type=oneshot
Slice=hetja.slice
ExecStart=/usr/bin/systemctl restart hetja-api.service hetja-worker.service hetja-web.service hetja-scan.service
# Restart, not reload: the room Caddyfile sets `admin off`, so `caddy reload`
# has no admin API to talk to and fails, leaving the old config live.
ExecStart=/usr/bin/systemctl restart hetja-caddy.service
