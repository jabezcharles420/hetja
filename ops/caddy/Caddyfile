{
	# Cloudflare terminates TLS at its edge and cloudflared hands us plain HTTP
	# over the tunnel, so Caddy must NOT try to obtain certificates or redirect
	# HTTP->HTTPS -- it would loop, and ACME cannot work anyway since nothing
	# reaches port 80 from the internet (this container is NAT'd with no
	# forward). Explicit http:// site addresses keep auto-HTTPS off.
	auto_https off
	admin localhost:2019
	# Trust Cloudflare's published edge ranges (module WeidiDeng/caddy-cloudflare-ip,
	# enhancement stack §L.6). In tunnel mode cloudflared connects from loopback
	# so this is future-proofing for CDN-direct mode; the live fix for tunnels is
	# the header_up CF-Connecting-IP rewrite below.
	servers {
		trusted_proxies cloudflare {
			interval 12h
			timeout 15s
		}
	}
}

(common) {
	encode zstd gzip
	header {
		# Delivered to the browser over Cloudflare's HTTPS, so HSTS is honest.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Powerful features (audit T10). Camera: the QR scanner and photo
		# capture; geolocation: geotagged scans and the "near me" care list.
		# Both first-party only. Everything else the app never uses is off, so
		# an injected script or a hostile embed cannot ask for it either.
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=(), serial=(), bluetooth=(), hid=(), browsing-topics=()"
		# A window this origin opens, or that opens it, gets no handle on the
		# other (tabnabbing, cross-window leaks). Nothing here relies on
		# window.opener: there is no OAuth popup.
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}
}

# (real_ip): cloudflared terminates the client connection at Cloudflare's edge
# and forwards the caller's real address as CF-Connecting-IP. Without this
# rewrite every stranger arrives at the API as 127.0.0.1 (the tunnel
# connector). Enhancement stack §L.6 / §N.7.
#
# Be precise about what this buys, because an earlier version of this comment
# was not: it said the rewrite exists so "@fastify/rate-limit would [not] cap
# the whole city as one IP". There is no @fastify/rate-limit in this
# repository. It is not a dependency of apps/api and is registered nowhere.
# Nor should there be a general one: INVARIANT 6 rate-limits per account or per
# attested device token and never per IP, deliberately, because Indian carrier
# CGNAT puts hundreds of real subscribers behind one address.
#
# What the rewrite actually fixes today is request logging (apps/api's pino
# serializer records request.ip) and any future per-IP flood cap on device-token
# MINTING. Bounding how many tokens an address can obtain is a different
# subject from capping what a user may do, and is the one place an IP limit is
# the right tool.
#
# Note also that `header_up` here REPLACES X-Forwarded-For rather than appending
# to it, so a request that somehow arrives without CF-Connecting-IP gets an
# empty header rather than its original value. That is the safe direction (an
# empty value cannot be spoofed into a trusted one), and apps/api pins
# `trustProxy` to a hop count rather than `true` so a forged header from a
# non-proxy is ignored, but TRUST_PROXY must actually be set in
# .env.production or Fastify ignores X-Forwarded-For entirely and request.ip
# stays loopback. See apps/api/src/config.ts.
(real_ip) {
	header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
}

# Canonical origin. Everything is served from one hostname on purpose: the
# feeder access token lives in localStorage and service-worker scope is
# per-origin, so a second live hostname would mean a second, disconnected login.
http://hetja.in {
	import common

	# Content-Security-Policy, REPORT-ONLY (audit T10): browsers log what this
	# policy would have blocked and block nothing, so it can be watched in the
	# console before it is enforced. Every origin is one the apps really load:
	#   script  fastly/cdn.jsdelivr.net: zxing-wasm (barcode-detector polyfill)
	#           fetches its .wasm there; 'wasm-unsafe-eval' compiles it
	#   style   fonts.googleapis.com: public/offline.html's web-font CSS
	#   img     api.hetja.in: dog photos (dogPhotoUrl); arcgis + cartocdn:
	#           the map's Esri and Carto tiles (components/map/tiles.ts)
	#   connect api.hetja.in (NEXT_PUBLIC_API_URL), *.supabase.co (dog
	#           profile RPCs), jsdelivr (the wasm fetch itself)
	#   font    fonts.gstatic.com: offline.html's web fonts
	#   frame   www.youtube-nocookie.com: the song embeds on /hetja
	#   worker  'self' blob:: both service workers, and zxing's worker
	# Only on this vhost: api.hetja.in serves JSON and photos, not pages.
	header Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://fastly.jsdelivr.net https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://api.hetja.in https://static-map-tiles-api.arcgis.com https://*.basemaps.cartocdn.com; connect-src 'self' https://api.hetja.in https://*.supabase.co https://fastly.jsdelivr.net https://cdn.jsdelivr.net; font-src 'self' https://fonts.gstatic.com; frame-src https://www.youtube-nocookie.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"

	# Cache-Control policy (enhancement stack §M.4). Cloudflare Cache Rules on
	# the dashboard are the edge half; these headers are the origin half of the
	# same contract. /d/* and the API catch-all are no-store: SOS state
	# changes underneath and a stale collar page is a life-safety bug, not a
	# perf regression. Guarded by ops/check-caddy-cache.sh in CI. Order
	# matters: more specific handles first (care* before the API catch-all).
	#
	# Every Cache-Control here is `header >Cache-Control`, i.e. deferred until
	# the upstream response is written, so it REPLACES whatever the upstream
	# sent. The plain `header Cache-Control` form this file used before was
	# applied first and reverse_proxy then ADDED the upstream's own value, so
	# the browser got two headers. Measured with caddy 2.11.4 against a stub
	# upstream that sends "public, max-age=86400":
	#     GET /d/abc   -> Cache-Control: no-store
	#                     Cache-Control: public, max-age=86400
	# Deferred, it is exactly the one value written here.
	#
	# Body caps (audit T5): 16KB on the read-only handles (all GET), 3MB on
	# the API catch-all, which is the only one a photo upload goes through.
	handle /api/v1/care* {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	# Public read-only reference data, identical for every caller (audit T17):
	# 60 s at the browser and at Cloudflare turns a burst of map loads into a
	# handful of origin hits on a box we share. The ward LIST only:
	# /api/v1/map/wards/<id> can carry the signed-in responder's own state
	# (apps/api map.ts sends private, no-store for it), so it keeps its
	# explicit no-store handle below. Exact paths here are deliberate:
	# `/api/v1/map/wards*` would also match the detail.
	handle /api/v1/wards {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/map/wards {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/stats/impact {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/map/places* {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/heatmap* {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/map/wards/* {
		header >Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	# Everything else under the API: no-store. 3MB body cap (audit T5): a
	# photo is at most MAX_PHOTO_BASE64_CHARS (2,796,204) of base64 inside a
	# JSON body the API caps at that + 64 KiB, so 3MB (3,000,000 bytes) holds
	# the biggest legal upload and refuses anything larger before it reaches
	# Node. The API's own 64 KiB default still binds every other route.
	handle /api/v1/* {
		request_body {
			max_size 3MB
		}
		header >Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}

	# QR collar landing -- the URL etched on the collar:
	#   https://hetja.in/d/<9-char-slug>?s=<hmac-sig>
	# The collar page's Inter subset (Android only; Apple devices use SF and
	# never request it). The one cacheable file under /d/: it is a static font,
	# not life-safety state, and re-downloading 13.6 KB on every scan over 4G
	# is exactly what the page's budget exists to prevent. Not `immutable`:
	# the filename is not content-hashed. More specific than /d/*, so Caddy
	# matches it first; every other /d/ path stays no-store.
	handle /d/inter-scan.woff2 {
		header >Cache-Control "public, max-age=2592000"
		reverse_proxy 127.0.0.1:8081 {
			import real_ip
		}
	}

	handle /d/* {
		header >Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8081 {
			import real_ip
		}
	}

	# Feeder-uploaded dog photos. Served straight off disk by Caddy, not through
	# the API: they are static bytes, and the 2 GB box should not stream them
	# through Node.
	#
	# This block did not exist until 2026-08-14, which meant NO dog photo had
	# ever been reachable. apps/web's dogPhotoUrl() builds
	# `${NEXT_PUBLIC_API_URL}/${photoKey}` = https://api.hetja.in/photos/<id>.webp,
	# apps/api registers no static handler at all (no @fastify/static anywhere),
	# and the api.hetja.in vhost below had only the two /api/v1 handles and no
	# catch-all, so every photo URL matched nothing. The feature had tests, a
	# storage layer and an upload pipeline, and no way to look at the result.
	#
	# The path arithmetic is load-bearing: storage keys are `photos/<uuid>.<ext>`
	# and storeLocal writes join(STORAGE_LOCAL_DIR, key), so with
	# STORAGE_LOCAL_DIR=/srv/hetja/photos a file lands at
	# /srv/hetja/photos/photos/<uuid>.<ext>. Rooting this handler at
	# /srv/hetja/photos means URI /photos/<uuid>.<ext> resolves to exactly that.
	# Change one and you must change the other.
	#
	# /srv/hetja/photos, NOT /root/hetja/data/photos, and that is a correctness
	# fix rather than a preference. Caddy runs as `User=caddy` (the distro unit),
	# and /root is mode 0700 root:root, so the caddy user cannot even traverse
	# into it, let alone read a file. Measured on the live box: with the handler
	# pointed inside /root, every photo URL returned
	#
	#     HTTP 403, content-length 0
	#
	# which is indistinguishable from "no such photo" to a browser. The handler
	# was correct, the storage layer was correct, and the bytes were unreachable
	# because of a directory permission four levels up the path.
	#
	# /srv is the right home anyway: it already holds the release directories and
	# the `current` symlink, it survives the checkout moving, and it can be made
	# readable by a service user without opening up root's home. Nothing
	# templates this file (unlike ops/systemd/*.service, which bootstrap.sh
	# renders __REPO_ROOT__ into), so the path is written out in full.
	#
	# STORAGE_LOCAL_DIR in apps/api/.env.production must match this exactly.
	#
	# Long-lived cache is safe here in a way it is not for /d/*: the filename is a
	# random UUID, so the bytes at a given URL never change. This is also the one
	# thing on the box that most wants caching: a dog photo is orders of
	# magnitude larger than any JSON response, on a Mumbai 4G connection.
	#
	# Safe to serve publicly ONLY because the API now strips metadata server-side
	# before writing (apps/api/src/lib/exif-strip.ts). Until that landed these
	# files could carry the original camera's GPS, and publishing them would have
	# defeated INVARIANT 2 through a channel the coarsening code never sees. If
	# that strip is ever removed, remove this handler with it.
	handle /photos/* {
		header >Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		root * /srv/hetja/photos
		file_server
	}

	# Next.js static assets: content-addressed, immutable for a year.
	handle /_next/static/* {
		header >Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy 127.0.0.1:3100 {
			import real_ip
		}
	}

	# Next.js feeder PWA (everything else).
	handle {
		reverse_proxy 127.0.0.1:3100 {
			import real_ip
		}
	}
}

http://www.hetja.in {
	import common
	redir https://hetja.in{uri} permanent
}

# Dedicated API hostname for non-browser and third-party clients. Browser
# traffic should prefer the same-origin path above.
http://api.hetja.in {
	import common
	handle /api/v1/care* {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	# Same public 60 s set as on hetja.in (see the comment there); ward
	# detail stays no-store.
	handle /api/v1/wards {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/map/wards {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/stats/impact {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/map/places* {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/heatmap* {
		request_body {
			max_size 16KB
		}
		header >Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/map/wards/* {
		header >Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	# No-store catch-all with the 3MB photo-upload cap (see hetja.in).
	handle /api/v1/* {
		request_body {
			max_size 3MB
		}
		header >Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}

	# Dog photos. This vhost is the one that actually matters for them:
	# apps/web/lib/api.ts builds photo URLs from NEXT_PUBLIC_API_URL, which
	# .env.example sets to https://api.hetja.in, so before this block existed,
	# every dog photo resolved to a hostname whose only two handlers were the two
	# /api/v1 ones above, with no catch-all. See the matching block on hetja.in
	# for the path arithmetic and why serving these publicly is safe.
	handle /photos/* {
		header >Cache-Control "public, max-age=31536000, immutable"
		header X-Content-Type-Options "nosniff"
		root * /srv/hetja/photos
		file_server
	}

	# Catch-all. Everything not matched above goes to the API so it can answer
	# for itself.
	#
	# Without this, Caddy has no route for an unmatched path on this vhost and
	# returns an EMPTY 200: no body, no content-type, not even the security
	# headers from `common`. Measured live before this block existed:
	#
	#   GET /healthz                -> 200, 0 bytes   (never reached Fastify)
	#   GET /                       -> 200, 0 bytes
	#   GET /anything-at-all        -> 200, 0 bytes
	#   GET /api/v1/nope            -> 404 JSON       (did reach Fastify)
	#
	# `/healthz` is the one that matters: apps/api/src/server.ts registers it and
	# it never ran. Any uptime monitor pointed at https://api.hetja.in/healthz
	# reported HEALTHY WITH THE API PROCESS DEAD, a false green on the only
	# signal an operator watches. It also meant every unknown path returned 200
	# to third-party clients, which every client-side error handler reads as
	# success-with-no-data rather than as the 404 it is.
	handle {
		header >Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
}
