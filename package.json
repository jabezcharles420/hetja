{
  "name": "straynet",
  "private": true,
  "version": "1.1.0",
  "description": "StrayNet — cityscale QR-collar, PWA and geofenced SOS network for Mumbai's stray dogs",
  "packageManager": "pnpm@9.15.0",
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "ledger:verify": "pnpm -C packages/ledger verify",
    "db:migrate": "pnpm -C packages/db migrate",
    "db:seed": "pnpm -C packages/db seed",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  }
}
