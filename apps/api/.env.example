# Hetja API — environment template. Copy to .env.production and fill.
NODE_ENV=production
PORT=8080
# Bind address -- 127.0.0.1 in production (Caddy fronts it)
HOST=127.0.0.1

# Postgres (app_user — NEVER the postgres superuser). In production this is
# the managed Supabase pooler, not a local install -- see AGENTS.md section
# (b)/(c) for where each value comes from.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=hetja
PGUSER=app_user
PGPASSWORD=change-me
# require for Supabase / any managed Postgres; leave unset for plaintext
# loopback in local dev. See packages/db/src/pool.ts.
# TLS mode, with libpq semantics: `require` encrypts without verifying,
# `verify-full` also validates the chain and hostname. Supabase's pooler is
# signed by their own private CA, so verify-full needs PGSSLROOTCERT pointing at
# the certificate from Settings -> Database -> SSL configuration. Prefer
# verify-full in production; `require` alone does not stop an active MITM.
PGSSLMODE=require
# PGSSLROOTCERT=/etc/ssl/certs/supabase-ca.crt

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
HETJA_HMAC_PEPPER=change-me
# DO NOT generate this with `openssl rand -hex 32` on a redeploy. It is the
# HMAC key already burned into every printed collar QR code. A fresh value
# here silently invalidates every collar printed before this moment -- copy
# the exact value from the previous deployment's .env.production instead.
# See AGENTS.md section (c).
HETJA_QR_SECRET=change-me
HETJA_DEVICE_SECRET=change-me
# Desktop-web proof-of-work fallback difficulty in leading zero bits. Valid
# range 8-20; the reasoning and the measurements are on the field itself in
# apps/api/src/config.ts -- read those before changing this.
#
# 16, not 18: ALTCHA encodes difficulty as a hex key prefix, so the value is
# rounded UP to a nibble boundary and 18 is really 20 effective bits. At 20
# bits the browser solver in apps/scan cannot finish inside its own 20s
# budget on a mid-range phone, and anonymous SOS attestation then degrades to
# "Couldn't confirm the report automatically" on the exact path where someone
# is standing over an injured dog. 16 rounds to 16 and clears with headroom.
#
# Do not read this as the anti-abuse control: at any of these settings the
# PoW costs an attacker well under two seconds per token. What bounds abuse is
# INVARIANT 7's 2/day + 5/week cap, keyed on the canonical device id.
DEVICE_POW_DIFFICULTY=16

# Web Push VAPID keypair (plan §3.2/§3.3). Generate ONCE with:
#   npx web-push generate-vapid-keys
# The public half is served to the client from GET
# /api/v1/push/vapid-public-key (apps/api/src/routes/push.ts) -- it is not
# a NEXT_PUBLIC_* build-time value, so the web app never needs its own
# copy. The private half signs every push and must never be logged or
# committed. Unlike HETJA_QR_SECRET, rotating this on a redeploy is safe:
# it just forces every subscribed browser to re-subscribe (existing
# push_subscriptions rows become dead endpoints from the push service's
# point of view, cleaned up lazily by the worker on the resulting 404/410),
# not a physical failure like a mismatched QR secret.
VAPID_PUBLIC_KEY=change-me
VAPID_PRIVATE_KEY=change-me
VAPID_SUBJECT=mailto:no-reply@hetja.in

# RESEARCH-2: pin to the real reverse proxy hop count (0 = none)
TRUST_PROXY=1

# Exact browser origins allowed in production (comma-separated)
CORS_ORIGINS=https://hetja.in,https://www.hetja.in

# Object storage: local (dev) or s3 (R2 in production)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/photos
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Email OTP delivery — Brevo SMTP relay (free tier, 300/day). Host/port are
# not secret; user/pass are Brevo's SMTP credentials (Brevo dashboard ->
# SMTP & API). Required in production -- config.ts refuses to boot without
# them rather than silently minting OTP codes nobody receives, which is what
# phone OTP did before this migration.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=change-me
BREVO_SMTP_PASS=change-me
# hetja.in is SPF/DKIM/DMARC-authenticated. A from-address on a domain
# without that (e.g. a personal Gmail address) is silently dropped by
# receiving providers rather than bouncing.
MAIL_FROM=no-reply@hetja.in
