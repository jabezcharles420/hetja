{
	# Cloudflare terminates TLS at its edge and cloudflared hands us plain HTTP
	# over the tunnel, so Caddy must NOT try to obtain certificates or redirect
	# HTTP->HTTPS -- it would loop, and ACME cannot work anyway since nothing
	# reaches port 80 from the internet (this container is NAT'd with no
	# forward). Explicit http:// site addresses keep auto-HTTPS off.
	auto_https off
	admin localhost:2019
	# Trust Cloudflare's published edge ranges (module WeidiDeng/caddy-cloudflare-ip,
	# enhancement stack §L.6). In tunnel mode cloudflared connects from loopback
	# so this is future-proofing for CDN-direct mode; the live fix for tunnels is
	# the header_up CF-Connecting-IP rewrite below.
	servers {
		trusted_proxies cloudflare {
			interval 12h
			timeout 15s
		}
	}
}

(common) {
	encode zstd gzip
	header {
		# Delivered to the browser over Cloudflare's HTTPS, so HSTS is honest.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# (real_ip): cloudflared terminates the client connection at Cloudflare's edge
# and forwards the caller's real address as CF-Connecting-IP. Without this
# rewrite every stranger arrives at the API as 127.0.0.1 (the tunnel
# connector). Enhancement stack §L.6 / §N.7.
#
# Be precise about what this buys, because an earlier version of this comment
# was not: it said the rewrite exists so "@fastify/rate-limit would [not] cap
# the whole city as one IP". There is no @fastify/rate-limit in this
# repository — it is not a dependency of apps/api and is registered nowhere.
# Nor should there be a general one: INVARIANT 6 rate-limits per account or per
# attested device token and never per IP, deliberately, because Indian carrier
# CGNAT puts hundreds of real subscribers behind one address.
#
# What the rewrite actually fixes today is request logging (apps/api's pino
# serializer records request.ip) and any future per-IP flood cap on device-token
# MINTING — bounding how many tokens an address can obtain is a different
# subject from capping what a user may do, and is the one place an IP limit is
# the right tool.
#
# Note also that `header_up` here REPLACES X-Forwarded-For rather than appending
# to it, so a request that somehow arrives without CF-Connecting-IP gets an
# empty header rather than its original value. That is the safe direction (an
# empty value cannot be spoofed into a trusted one), and apps/api pins
# `trustProxy` to a hop count rather than `true` so a forged header from a
# non-proxy is ignored — but TRUST_PROXY must actually be set in
# .env.production or Fastify ignores X-Forwarded-For entirely and request.ip
# stays loopback. See apps/api/src/config.ts.
(real_ip) {
	header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
}

# Canonical origin. Everything is served from one hostname on purpose: the
# feeder access token lives in localStorage and service-worker scope is
# per-origin, so a second live hostname would mean a second, disconnected login.
http://hetja.in {
	import common

	# Cache-Control policy (enhancement stack §M.4). Cloudflare Cache Rules on
	# the dashboard are the edge half; these headers are the origin half of the
	# same contract. /d/* and the API catch-all are no-store — SOS state
	# changes underneath and a stale collar page is a life-safety bug, not a
	# perf regression. Guarded by ops/check-caddy-cache.sh in CI. Order
	# matters: more specific handles first (care* before the API catch-all).
	handle /api/v1/care* {
		header Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}

	# QR collar landing -- the URL etched on the collar:
	#   https://hetja.in/d/<9-char-slug>?s=<hmac-sig>
	handle /d/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8081 {
			import real_ip
		}
	}

	# Next.js static assets: content-addressed, immutable for a year.
	handle /_next/static/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy 127.0.0.1:3100 {
			import real_ip
		}
	}

	# Next.js feeder PWA (everything else).
	handle {
		reverse_proxy 127.0.0.1:3100 {
			import real_ip
		}
	}
}

http://www.hetja.in {
	import common
	redir https://hetja.in{uri} permanent
}

# Dedicated API hostname for non-browser and third-party clients. Browser
# traffic should prefer the same-origin path above.
http://api.hetja.in {
	import common
	handle /api/v1/care* {
		header Cache-Control "public, max-age=60, s-maxage=60"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
	handle /api/v1/* {
		header Cache-Control "no-store"
		reverse_proxy 127.0.0.1:8080 {
			import real_ip
		}
	}
}
