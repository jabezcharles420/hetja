{
  "name": "straynet",
  "private": true,
  "version": "1.1.0",
  "description": "Hetja — cityscale QR-collar, PWA and geofenced SOS network for Mumbai's stray dogs",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "ledger:verify": "pnpm -C packages/ledger verify",
    "db:migrate": "pnpm -C packages/db migrate",
    "db:seed": "pnpm -C packages/db seed",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
