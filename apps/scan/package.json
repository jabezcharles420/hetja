{
  "name": "@hetja/scan",
  "version": "1.1.0",
  "private": true,
  "description": "Public scan landing — zero-install, static HTML + vanilla TS, <40KB gzipped",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "size:gate": "node scripts/size-gate.mjs",
    "serve": "node scripts/serve.mjs",
    "start": "node scripts/build.mjs && node scripts/serve.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
