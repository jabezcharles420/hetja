# StrayNet API — environment template. Copy to .env.production and fill.
NODE_ENV=production
PORT=8080

# Postgres (app_user — NEVER the postgres superuser)
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=straynet
PGUSER=app_user
PGPASSWORD=change-me

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STRAYNET_HMAC_PEPPER=change-me
STRAYNET_QR_SECRET=change-me
STRAYNET_DEVICE_SECRET=change-me
DEVICE_POW_DIFFICULTY=14

# RESEARCH-2: pin to the real reverse proxy hop count (0 = none)
TRUST_PROXY=0

# Object storage: local (dev) or s3 (R2 in production)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/photos
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
