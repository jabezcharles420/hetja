node_modules/
dist/
build/
.env
.env.*
!.env.example
*.log
.DS_Store
coverage/
.vercel/
.next/

# secrets + runtime state (never commit)
apps/api/.env.production
apps/*/data/
**/dist/
apps/scan/dist/
*.local

# Supabase data dumps hold real rows (feeders.phone_hmac, collar hmac_sig).
# The schema and hardening SQL are safe to track; the data is not.
ops/supabase/*_data.sql

# incremental tsc cache — regenerated on every build
*.tsbuildinfo

# Playwright output. apps/web/playwright.config.ts deliberately points
# outputDir/outputFolder under apps/web/build/ so the existing `build/` rule
# already covers them, but the conventional default paths are listed too: a run
# with an overridden config, or `npx playwright test` from a different cwd, still
# writes here, and a screenshot of a failing a11y run is not something to commit.
playwright-report/
test-results/
blob-report/
.playwright/

# Python virtualenv for apps/ai -- committed by mistake once, regenerate with
# `python3 -m venv .venv && .venv/bin/pip install -r requirements.txt`
apps/ai/.venv/
apps/ai/__pycache__/
