# StrayNet API — environment template. Copy to .env.production and fill.
NODE_ENV=production
PORT=8080
# Bind address -- 127.0.0.1 in production (Caddy fronts it)
HOST=127.0.0.1

# Postgres (app_user — NEVER the postgres superuser). In production this is
# the managed Supabase pooler, not a local install -- see AGENTS.md section
# (b)/(c) for where each value comes from.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=straynet
PGUSER=app_user
PGPASSWORD=change-me
# require for Supabase / any managed Postgres; leave unset for plaintext
# loopback in local dev. See packages/db/src/pool.ts.
# TLS mode, with libpq semantics: `require` encrypts without verifying,
# `verify-full` also validates the chain and hostname. Supabase's pooler is
# signed by their own private CA, so verify-full needs PGSSLROOTCERT pointing at
# the certificate from Settings -> Database -> SSL configuration. Prefer
# verify-full in production; `require` alone does not stop an active MITM.
PGSSLMODE=require
# PGSSLROOTCERT=/etc/ssl/certs/supabase-ca.crt

# Secrets — generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
STRAYNET_HMAC_PEPPER=change-me
# DO NOT generate this with `openssl rand -hex 32` on a redeploy. It is the
# HMAC key already burned into every printed collar QR code. A fresh value
# here silently invalidates every collar printed before this moment -- copy
# the exact value from the previous deployment's .env.production instead.
# See AGENTS.md section (c).
STRAYNET_QR_SECRET=change-me
STRAYNET_DEVICE_SECRET=change-me
# Desktop-web proof-of-work fallback difficulty in leading zero bits (see
# apps/api/src/routes/devices.ts). 14 is only ~2^14 = 16,384 SHA-256
# attempts -- a few milliseconds on any real CPU -- which is a weak speed
# bump for a token whose whole job is being the INVARIANT 7 anon-report
# rate-limit subject. Recommended production value: 18-20 (roughly 0.3-1s
# on a mid-range phone/laptop -- still a one-time, once-per-device cost,
# invisible to someone actually filing a report).
DEVICE_POW_DIFFICULTY=14

# RESEARCH-2: pin to the real reverse proxy hop count (0 = none)
TRUST_PROXY=1

# Exact browser origins allowed in production (comma-separated)
CORS_ORIGINS=https://hetja.in,https://www.hetja.in

# Object storage: local (dev) or s3 (R2 in production)
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/photos
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
